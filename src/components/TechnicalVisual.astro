---
import FinancialVisual from "./FinancialVisual.astro";
interface Props {
  kind: string;
}
const { kind } = Astro.props;
const labels: Record<string, string> = {
  spirit:
    "Robô articulado em movimento, representando integração de eletrônica, controle e liderança de engenharia.",
  adelphi:
    "Aeromodelo com hélice girando e trajetória de voo, representando o Projeto Hórus.",
  professor:
    "Professor apontando para uma equação no quadro, representando as aulas de Álgebra II.",
  ibge: "Mapa esquemático com rotas e pontos de coleta, representando coordenação de equipes de campo no Censo.",
};
---

{
  kind === "cnpq" ? (
    <FinancialVisual />
  ) : (
    <div
      class={`technical-visual visual-${kind}`}
      role="img"
      aria-label={labels[kind] || "Ilustração conceitual de engenharia"}
    >
      <div class="visual-grid" aria-hidden="true" />
      <>
        <svg
          viewBox="0 0 600 400"
          fill="none"
          class="schematic scene-illustration"
          aria-hidden="true"
        >
          {kind === "spirit" ? (
            <g
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <ellipse
                cx="300"
                cy="340"
                rx="145"
                ry="15"
                fill="currentColor"
                opacity=".07"
                stroke="none"
              />
              <path d="M80 320h440M80 325v-10m440 10v-10" opacity=".2" />
              <g class="robot-body">
                <path d="M300 83V60" />
                <circle
                  cx="300"
                  cy="53"
                  r="7"
                  fill="currentColor"
                  class="robot-beacon"
                />
                <rect
                  x="238"
                  y="84"
                  width="124"
                  height="84"
                  rx="22"
                  fill="#dceafa"
                />
                <rect
                  x="251"
                  y="105"
                  width="98"
                  height="37"
                  rx="12"
                  fill="#ffffff"
                />
                <circle cx="273" cy="122" r="6" fill="currentColor" />
                <circle cx="327" cy="122" r="6" fill="currentColor" />
                <path d="M287 153h26M278 169v15m44-15v15" />
                <rect
                  x="236"
                  y="184"
                  width="128"
                  height="105"
                  rx="18"
                  fill="#dceafa"
                />
                <circle cx="300" cy="223" r="22" />
                <path d="m285 223 10 10 21-23" />
                <path d="M264 266h72" stroke-dasharray="5 7" />
                <g class="robot-arm-left">
                  <circle cx="222" cy="205" r="12" />
                  <path d="M212 216 181 247l16 30" stroke-width="13" />
                  <circle cx="181" cy="247" r="10" fill="#f1f6fd" />
                  <path d="m192 278-8 15m15-14 10 11" />
                </g>
                <g class="robot-arm-right">
                  <circle cx="378" cy="205" r="12" />
                  <path d="m389 210 34-27 10-44" stroke-width="13" />
                  <circle cx="423" cy="183" r="10" fill="#f1f6fd" />
                  <path d="m433 139-12-15m14 12 15-11" />
                </g>
                <path d="M267 291v24m66-24v24" stroke-width="14" />
                <rect
                  x="242"
                  y="316"
                  width="53"
                  height="18"
                  rx="8"
                  fill="#c5daf4"
                />
                <rect
                  x="308"
                  y="316"
                  width="53"
                  height="18"
                  rx="8"
                  fill="#c5daf4"
                />
              </g>
              <g
                opacity=".6"
                font-size="11"
                font-family="monospace"
                fill="currentColor"
                stroke="none"
              >
                <text x="60" y="100">
                  CONTROLE
                </text>
                <text x="444" y="276">
                  ATUADORES
                </text>
              </g>
              <path d="M60 112h70l45 40m266 109h70" opacity=".35" />
            </g>
          ) : kind === "adelphi" ? (
            <g
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                class="flight-route"
                d="M50 300C90 200 155 320 228 232S420 100 550 200"
                stroke-dasharray="5 10"
                opacity=".4"
              />
              <circle
                cx="300"
                cy="205"
                r="137"
                stroke-dasharray="2 13"
                opacity=".25"
              />
              <g class="airplane-flight">
                <path
                  d="m300 74 17 109 172 68v20l-171-29-6 67 48 29v12l-60-13-60 13v-12l48-29-6-67-171 29v-20l172-68Z"
                  fill="#dbeafa"
                />
                <path
                  d="M300 100v215M142 253l141-47m175 47-141-47"
                  opacity=".5"
                />
                <ellipse cx="300" cy="174" rx="10" ry="24" fill="#b8d3f2" />
                <g class="plane-propeller">
                  <path d="M256 74h88" stroke-width="5" />
                  <circle cx="300" cy="74" r="5" fill="currentColor" />
                </g>
              </g>
              <text
                x="38"
                y="63"
                fill="currentColor"
                stroke="none"
                font-size="12"
                font-family="monospace"
              >
                HÓRUS / AERODESIGN
              </text>
            </g>
          ) : kind === "professor" ? (
            <g
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect
                x="208"
                y="77"
                width="322"
                height="201"
                rx="7"
                fill="#e4eefb"
              />
              <path d="M220 263h298M250 278v49m240-49v49" />
              <g fill="currentColor" stroke="none" font-family="monospace">
                <text x="244" y="113" font-size="12">
                  ÁLGEBRA II
                </text>
                <text x="264" y="165" font-size="25">
                  Ax = b
                </text>
                <text x="265" y="204" font-size="18">
                  ideias → compreensão
                </text>
              </g>
              <path
                class="chalk-line"
                pathLength="1"
                d="M264 177h115"
                stroke-width="3"
              />
              <g class="teacher-body">
                <circle cx="150" cy="129" r="27" fill="#d4e4f8" />
                <path d="M124 119q18-37 49 0M146 142q8 6 15-1" />
                <path
                  d="M128 163q-20 13-20 46v47h87v-53q0-29-22-40Z"
                  fill="#d4e4f8"
                />
                <path d="m137 166 13 17 13-17m-13 17v57" />
                <path d="m129 257-9 71m52-71 10 71" stroke-width="15" />
                <path d="M105 333h28m39 0h28" stroke-width="7" />
                <path d="m106 184-18 39 29 23" stroke-width="12" />
                <g class="teacher-arm">
                  <path d="m188 185 32 21 39-37" stroke-width="12" />
                  <path d="m259 169 31-32" stroke-width="3" />
                </g>
              </g>
              <path d="M63 340h469" opacity=".25" />
            </g>
          ) : (
            <g stroke="currentColor" stroke-width="2" stroke-linejoin="round">
              <path
                d="m74 114 145-42 155 39 148-44v240l-148 44-155-39-145 41Z"
                fill="#dceafa"
              />
              <path d="M219 72v240m155-201v240" opacity=".65" />
              <path
                d="m83 173 129-33 165 35 136-41M85 275l125-40 160 40 144-32M142 103l9 226M291 93l-10 235M446 91l17 233"
                opacity=".23"
              />
              <path
                d="m98 305 66-53-12-43 106-56 73 59 81-17 60-64"
                class="map-route"
                stroke-width="3"
                stroke-dasharray="6 8"
              />
              {[
                { x: 164, y: 252 },
                { x: 258, y: 153 },
                { x: 331, y: 212 },
                { x: 472, y: 131 },
              ].map((p, i) => (
                <g style={`--pin-delay: ${i * 0.6}s`}>
                  <circle
                    class="map-pulse"
                    cx={p.x}
                    cy={p.y}
                    r="18"
                    opacity=".2"
                  />
                  <path
                    d={`M${p.x} ${p.y}c-6-8-17-18-17-28a17 17 0 0 1 34 0c0 10-11 20-17 28Z`}
                    fill="#ffffff"
                  />
                  <circle cx={p.x} cy={p.y - 28} r="5" fill="currentColor" />
                </g>
              ))}
              <text
                x="82"
                y="52"
                fill="currentColor"
                stroke="none"
                font-family="monospace"
                font-size="12"
              >
                CENSO / EQUIPES EM CAMPO
              </text>
            </g>
          )}
        </svg>
        <span class="visual-caption">
          ILUSTRAÇÃO CONCEITUAL / {kind.toUpperCase()}
        </span>
      </>
    </div>
  )
}
