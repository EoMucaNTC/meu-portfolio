<div class="network-stage">
  <div class="network-fallback" aria-hidden="true">
    <i></i><i></i><i></i>
  </div><canvas id="network" aria-hidden="true"></canvas><button
    id="motion-toggle"
    type="button"
    aria-pressed="false"
    hidden>Pausar movimento</button
  >
</div>
<script>
  const canvas = document.querySelector<HTMLCanvasElement>("#network");
  const button = document.querySelector<HTMLButtonElement>("#motion-toggle");
  const ctx = canvas?.getContext("2d");
  if (canvas && ctx && button) {
    const motion = matchMedia("(prefers-reduced-motion: reduce)");
    const coarse = matchMedia("(pointer: coarse)");
    let paused = motion.matches,
      visible = false,
      frame = 0,
      angle = 0.4,
      last = 0;
    let width = 0,
      height = 0,
      pointerX = 0,
      pointerY = 0;
    const points = Array.from(
      { length: coarse.matches ? 100 : 180 },
      (_, i) => {
        const count = coarse.matches ? 100 : 180;
        const y = 1 - (i / (count - 1)) * 2;
        const radius = Math.sqrt(1 - y * y),
          theta = Math.PI * (3 - Math.sqrt(5)) * i;
        return { x: Math.cos(theta) * radius, y, z: Math.sin(theta) * radius };
      },
    );
    const edges: [number, number][] = [];
    points.forEach((a, i) =>
      points.slice(i + 1).forEach((b, j) => {
        if (Math.hypot(a.x - b.x, a.y - b.y, a.z - b.z) < 0.34)
          edges.push([i, i + j + 1]);
      }),
    );
    function draw() {
      if (!ctx || !canvas) return;
      ctx.clearRect(0, 0, width, height);
      const size = Math.min(width, height) * 0.34,
        rotation = angle + pointerX * 0.3;
      const projected = points.map((p) => {
        const x = p.x * Math.cos(rotation) + p.z * Math.sin(rotation);
        const z = p.z * Math.cos(rotation) - p.x * Math.sin(rotation);
        const y =
          p.y * Math.cos(pointerY * 0.25) - z * Math.sin(pointerY * 0.25);
        const scale = 3 / (3 - z * 0.4);
        return {
          x: width / 2 + x * size * scale,
          y: height / 2 + y * size * scale,
          z,
        };
      });
      const glow = ctx.createRadialGradient(
        width / 2,
        height / 2,
        0,
        width / 2,
        height / 2,
        size * 1.45,
      );
      glow.addColorStop(0, "#b9ed7020");
      glow.addColorStop(1, "#b9ed7000");
      ctx.fillStyle = glow;
      ctx.fillRect(0, 0, width, height);
      for (const [i, j] of edges) {
        const a = projected[i],
          b = projected[j];
        ctx.strokeStyle = `rgba(193,238,137,${0.12 + (a.z + b.z + 2) * 0.09})`;
        ctx.lineWidth = 0.7;
        ctx.beginPath();
        ctx.moveTo(a.x, a.y);
        ctx.lineTo(b.x, b.y);
        ctx.stroke();
      }
      for (const p of projected) {
        ctx.fillStyle = `rgba(211,255,164,${0.3 + (p.z + 1) * 0.35})`;
        ctx.beginPath();
        ctx.arc(p.x, p.y, 1.1 + (p.z + 1) * 0.65, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.strokeStyle = "#c8ef8c60";
      ctx.lineWidth = 0.6;
      ctx.beginPath();
      ctx.ellipse(
        width / 2,
        height / 2,
        size * 1.3,
        size * 0.3,
        -0.45,
        0,
        Math.PI * 2,
      );
      ctx.stroke();
    }
    function tick(time: number) {
      frame = 0;
      if (paused || !visible || document.hidden) return;
      angle += Math.min(time - last, 50) * 0.00012;
      last = time;
      draw();
      frame = requestAnimationFrame(tick);
    }
    function sync() {
      cancelAnimationFrame(frame);
      frame = 0;
      document.documentElement.dataset.motionPaused = String(paused);
      window.dispatchEvent(new Event("portfolio:motion"));
      button!.textContent = paused ? "Ativar animações" : "Pausar animações";
      button!.setAttribute("aria-pressed", String(paused));
      draw();
      if (!paused && visible && !document.hidden) {
        last = performance.now();
        frame = requestAnimationFrame(tick);
      }
    }
    new ResizeObserver(() => {
      width = canvas.clientWidth;
      height = canvas.clientHeight;
      const dpr = Math.min(devicePixelRatio, coarse.matches ? 1.25 : 1.75);
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      draw();
    }).observe(canvas);
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      sync();
    }).observe(canvas);
    canvas.parentElement?.addEventListener("pointermove", (event) => {
      if (paused || coarse.matches) return;
      const rect = canvas.getBoundingClientRect();
      pointerX = (event.clientX - rect.left) / rect.width - 0.5;
      pointerY = (event.clientY - rect.top) / rect.height - 0.5;
    });
    canvas.parentElement?.addEventListener("pointerleave", () => {
      pointerX = 0;
      pointerY = 0;
    });
    button.hidden = false;
    button.addEventListener("click", () => {
      paused = !paused;
      sync();
    });
    motion.addEventListener("change", () => {
      paused = motion.matches;
      sync();
    });
    document.addEventListener("visibilitychange", sync);
    canvas.parentElement?.classList.add("canvas-ready");
  }
</script>
