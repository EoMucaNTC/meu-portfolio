---
const { titulo, descricao, link, tags } = Astro.props as {
  titulo: string;
  descricao: string;
  link: string;
  tags: string[];
};
---

<div
  class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow"
>
  <h3 class="text-xl font-bold text-gray-900 mb-2">{titulo}</h3>
  <p class="text-gray-600 mb-4 leading-relaxed">{descricao}</p>

  <div class="flex flex-wrap gap-2 mb-6">
    {
      tags.map((tag: string) => (
        <span class="bg-blue-50 text-blue-700 text-xs font-semibold px-2.5 py-1 rounded-md">
          {tag}
        </span>
      ))
    }
  </div>

  <a
    href={link}
    class="text-blue-600 font-medium hover:text-blue-800 transition-colors"
  >
    Ver detalhes →
  </a>
</div>
