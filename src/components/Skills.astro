---
const skillCategories = [
  {
    title: "Dados e Automação",
    skills: ["Python", "Power BI", "Excel Avançado", "Modelagem Financeira (Monte Carlo)"]
  },
  {
    title: "Embarcados & IoT",
    skills: ["ESP32", "Conectividade", "Integração Controle/Atuadores", "Robótica"]
  },
  {
    title: "Telecomunicações & Redes",
    skills: ["Infraestrutura de Redes", "Operações de Telecom", "Internet das Coisas"]
  },
  {
    title: "Gestão & Soft Skills",
    skills: ["Liderança de Equipe", "Gestão de Projetos", "Troubleshooting", "Orçamentos"]
  }
];
---
<section id="habilidades" class="py-20 bg-white">
  <div class="max-w-5xl mx-auto px-6">
    <h2 class="text-3xl font-bold text-slate-900 mb-12">Habilidades e Interesses</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {skillCategories.map(category => (
        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-100 shadow-sm">
          <h3 class="text-lg font-bold text-slate-800 mb-4">{category.title}</h3>
          <div class="flex flex-wrap gap-2">
            {category.skills.map(skill => (
              <span class="bg-white border border-slate-200 text-slate-700 text-sm font-medium px-3 py-1.5 rounded-md shadow-sm">
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
