---
import { existsSync } from "node:fs";
import TechnicalVisual from "./TechnicalVisual.astro";
const experiences = [
  {
    id: "spirit",
    role: "Vice-Capitão & Diretor de Engenharia",
    company: "Equipe Spirit Robótica",
    period: "Jul 2023 - Presente",
    description:
      "Membro fundador. Lidero desde o planejamento à execução de projetos reais de robótica. Atuação na transformação de conceitos em sistemas integrados, gestão de engenharia, além de coordenar orçamentos e a equipe técnica.",
    image: "/images/spirit.jpg",
    imageAlt: "Equipe Spirit Robótica",
  },
  {
    id: "cnpq",
    role: "Pesquisador IC (Bolsista CNPq)",
    company: "Center for Advanced and Sustainable Technologies (UNESP)",
    period: "Set 2024 - Presente",
    description:
      "Pesquisa em viabilidade econômica de plantas de reciclagem de baterias Íon-Lítio. Modelagem financeira e estudo de sensibilidade por meio de simulações de Monte Carlo (VPL, TIR, Payback).",
    image: "/images/cnpq.jpg",
    imageAlt: "Pesquisa CNPq",
  },
  {
    id: "adelphi",
    role: "Membro de Eletrônica e Sistemas Embarcados",
    company: "Adelphi AeroDesign Team",
    period: "Abr 2023 - Set 2024",
    description:
      "Elaboração de projetos elétricos e eletrônicos para aeromodelos (Projeto Hórus). Atuação com sistemas de controle eletrônico, desenvolvimento embarcado e resolução de problemas práticos de engenharia.",
    image: "/images/adelphi.jpg",
    imageAlt: "Adelphi AeroDesign Team",
  },
  {
    id: "professor",
    role: "Professor Voluntário & Representante de Turma",
    company: "UNESP SJBV",
    period: "Mar 2023 - Nov 2025",
    description:
      "Aulas de Álgebra II no Cursinho Popular Sanjoanense, apoiando estudantes em vulnerabilidade social. Como representante discente, atuei na comunicação entre alunos, professores e coordenação.",
    image: "/images/professor.jpg",
    imageAlt: "Professor Voluntário",
  },
  {
    id: "ibge",
    role: "Agente Supervisor (Censo 2022)",
    company: "IBGE",
    period: "Jun 2022 - Mar 2023",
    description:
      "Coordenação de equipes de recenseadores em campo na maior operação estatística do país. Responsável pelo cumprimento de prazos, controle de qualidade dos dados coletados e gestão de pessoas.",
    image: "/images/ibge.jpg",
    imageAlt: "IBGE Censo 2022",
  },
];
---

<section id="experiencia" class="experience shell section-space">
  <div class="section-heading">
    <div>
      <p class="eyebrow">03 / TRAJETÓRIA</p><h2>
        Engenharia feita<br />de <em>experiências.</em>
      </h2>
    </div><p class="muted">
      Da liderança à pesquisa.<br />Do conceito ao campo.
    </p>
  </div>
  {
    experiences.map((exp, index) => (
      <article id={`detail-${exp.id}`} class="experience-scene">
        <>
          <div class="experience-art">
            <TechnicalVisual kind={exp.id} />
            {existsSync(`public${exp.image}`) && (
              <img
                src={exp.image}
                alt={exp.imageAlt}
                loading="lazy"
                decoding="async"
                width="1280"
                height="720"
              />
            )}
            <span class="scene-number">0{index + 1}</span>
          </div>
          <div class="experience-copy">
            <>
              <p class="eyebrow">{exp.period}</p>
              <h3>{exp.role}</h3>
              <p class="company">{exp.company}</p>
              <p class="muted">{exp.description}</p>
              <span class="scene-index">CAPÍTULO 0{index + 1} / 05</span>
            </>
          </div>
        </>
      </article>
    ))
  }
</section>
