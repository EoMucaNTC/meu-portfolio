      <!-- E-mail -->
      <a href="mailto:ramos.filho@unesp.br" class="bg-white/90 border border-slate-300 text-slate-700 px-8 py-3.5 rounded-lg font-semibold hover:bg-slate-50 hover:scale-105 transition-all shadow-sm">
        ramos.filho@unesp.br
