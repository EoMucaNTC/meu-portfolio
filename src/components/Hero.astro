      <!-- Botão LinkedIn -->
      <a href="https://www.linkedin.com/in/joseclaudioprf/" target="_blank" class="bg-white/90 border border-slate-300 text-slate-700 px-8 py-3.5 rounded-lg font-semibold hover:bg-slate-50 hover:scale-105 transition-all shadow-sm">
        LinkedIn
