---
import ParticleNetwork from "./ParticleNetwork.astro";
import ConnectionBackground from "./ConnectionBackground.astro";
import "../styles/scenes.css";
---

<ConnectionBackground />
<section id="inicio" class="hero shell">
  <div class="hero-copy">
    <p class="eyebrow">
      <span class="signal-dot"></span> JOSÉ CLÁUDIO · PORTFÓLIO
    </p><h1>Entre ideias<br />e <em>conexões.</em></h1><p class="hero-intro">
      Sou José Cláudio Pereira Ramos Filho.<br />Estudante de Engenharia
      Eletrônica e de Telecomunicações na UNESP.
    </p><p class="muted hero-description">
      Eletrônica e sistemas embarcados · ESP32 e IoT · Python e análise de
      dados. Interesse em infraestrutura de redes, com experiência em robótica,
      pesquisa e liderança de equipes.
    </p><div class="actions">
      <a class="button primary" href="#projetos">Explorar projetos ↗</a><a
        class="text-link"
        href="#experiencia">Minha trajetória ↓</a
      >
    </div>
  </div>
  <div class="hero-instrument">
    <ParticleNetwork /><span class="instrument-label"
      >FIG. 01 / SISTEMAS CONECTADOS</span
    ><span class="instrument-side">ELETRÔNICA ↔ TELECOMUNICAÇÕES</span>
  </div>
  <div class="hero-bottom">
    <span>CONCEBER. CONECTAR. CONSTRUIR.</span><a href="#sobre"
      >Explore a conexão entre as áreas ↓</a
    ><span>01 — 05</span>
  </div>
</section>
