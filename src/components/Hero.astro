<section id="sobre" class="relative py-20 md:py-28 overflow-hidden">
  
  <!-- Blueprint Grid Background -->
  <div class="blueprint-grid absolute inset-0 z-0"></div>
  
  <!-- Coordinate labels que aparecem com animação -->
  <div class="absolute top-8 left-8 text-blue-300/40 text-xs font-mono hidden md:block blueprint-label" style="animation-delay: 0.5s">
    x: 0, y: 0
  </div>
  <div class="absolute top-8 right-8 text-blue-300/40 text-xs font-mono hidden md:block blueprint-label" style="animation-delay: 0.8s">
    x: 1920, y: 0
  </div>
  <div class="absolute bottom-8 left-8 text-blue-300/40 text-xs font-mono hidden md:block blueprint-label" style="animation-delay: 1.1s">
    x: 0, y: 1080
  </div>

  <!-- Conteúdo principal -->
  <div class="max-w-5xl mx-auto px-6 relative z-10">
    <div class="inline-block px-4 py-1.5 mb-6 rounded-full bg-blue-100/90 text-blue-800 text-sm font-semibold tracking-wide hero-fade-in" style="animation-delay: 0.2s">
      Engenharia Eletrônica e de Telecomunicações
